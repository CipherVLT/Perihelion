+
+// Perihelion: the right-click menu of an app in the drawer.
+var pinToDockMenu *gtk.Menu
+
+func showPinToDockMenu(event *gdk.Event, desktopID string) {
+	menu := gtk.NewMenu()
+	menu.SetName("pin-to-dock-menu")
+	item := gtk.NewMenuItemWithLabel("Pin to dock")
+	item.ConnectActivate(func() {
+		cmd := exec.Command("perihelion-dock-pin", desktopID)
+		if err := cmd.Start(); err != nil {
+			log.Warnf("perihelion-dock-pin: %s", err)
+			return
+		}
+		go cmd.Wait()
+	})
+	menu.Append(item)
+	menu.ShowAll()
+	pinToDockMenu = menu // keep it alive while it is shown
+	menu.PopupAtPointer(event)
+}
