# Perihelion defaults (your own settings override these).
# After editing: sudo dconf update
[org/gnome/desktop/interface]
icon-theme='Numix-Circle'
cursor-theme='Bibata-Modern-Classic'
cursor-size=24
monospace-font-name='DejaVu Sans Mono 11'
# Dark by default: libadwaita/GTK4 apps (Perihelion Settings, Files...) and
# the portal's appearance setting follow this.
color-scheme='prefer-dark'
