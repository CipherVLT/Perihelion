#!/usr/bin/bash
# Run Strata from ~/.local/bin so its built-in updater can replace it.
#
# The image's copy (/usr/libexec/strata/strata) is read-only, like all of
# /usr. On first run it's copied to ~/.local/bin/strata, which Strata's
# "Update" button can then update in place. A newer copy shipped by an image
# update replaces an older one in your home; a newer one Strata installed
# itself is kept.
set -u
system=/usr/libexec/strata/strata
user="${HOME:-}/.local/bin/strata"

version_of() {
    "$1" --version 2>/dev/null | awk 'NR==1 {print $2}'
}

if [[ -n "${HOME:-}" && -w "${HOME}" ]]; then
    # Perihelion's right-click actions ("Extract here" / "Extract to…" for
    # .tar.xz and friends). Strata only reads actions from your config
    # folder, so each one is copied there once. The stamp means one you
    # delete or edit is never put back or overwritten.
    actions="${XDG_CONFIG_HOME:-${HOME}/.config}/strata/actions"
    stamps="${XDG_STATE_HOME:-${HOME}/.local/state}/perihelion/strata-actions"
    for src in /usr/share/perihelion/strata/actions/*/; do
        [[ -f "${src}action.toml" ]] || continue
        id=$(basename "${src}")
        [[ -e "${stamps}/${id}" ]] && continue
        if [[ ! -e "${actions}/${id}" ]]; then
            install -d -m 700 "${actions}" 2>/dev/null \
                && install -Dm644 "${src}action.toml" "${actions}/${id}/action.toml" 2>/dev/null \
                || continue
        fi
        install -d "${stamps}" 2>/dev/null && : > "${stamps}/${id}"
    done
    if [[ ! -x "${user}" ]]; then
        install -Dm755 "${system}" "${user}" 2>/dev/null || true
    else
        have=$(version_of "${user}")
        ship=$(version_of "${system}")
        if [[ -n "${ship}" && "${have}" != "${ship}" ]] \
            && [[ -z "${have}" || "$(printf '%s\n%s\n' "${have}" "${ship}" | sort -V | tail -n1)" == "${ship}" ]]; then
            tmp="${user}.new.$$"
            install -m755 "${system}" "${tmp}" 2>/dev/null && mv -f "${tmp}" "${user}"
        fi
    fi
    if [[ -x "${user}" ]]; then
        exec "${user}" "$@"
    fi
fi
exec "${system}" "$@"
