#!/usr/bin/env bash
# Wallpaper picker (Super+Shift+W): lists the images in ~/Pictures/Wallpapers
# (and Perihelion's own) in fuzzel and applies the one you pick.
#   Mango:          perihelion-wallpaper (swaybg), remembered across logins
#   Hyprland, Niri: Event Horizon's wallpaper (horizon-wallpaper --set)
set -euo pipefail

pictures=$(xdg-user-dir PICTURES 2>/dev/null || echo "${HOME}/Pictures")
walls="${pictures}/Wallpapers"
mkdir -p "${walls}"

mapfile -t images < <(
    find "${walls}" /usr/share/backgrounds/perihelion -maxdepth 2 -type f \
        \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
        2>/dev/null | sort
)

if (( ${#images[@]} == 0 )); then
    printf '%s\n' "No images yet: put wallpapers in ${walls}" |
        fuzzel --dmenu --prompt 'wallpaper > ' --lines 1 --width 60 >/dev/null || true
    exit 0
fi

# Show "folder/name" so same-named files stay distinguishable.
choice=$(for img in "${images[@]}"; do
    printf '%s\n' "$(basename "$(dirname "${img}")")/$(basename "${img}")"
done | fuzzel --dmenu --prompt 'wallpaper > ' --width 50) || exit 0

for img in "${images[@]}"; do
    if [[ "$(basename "$(dirname "${img}")")/$(basename "${img}")" == "${choice}" ]]; then
        if command -v horizon-wallpaper >/dev/null && pgrep -x horizon >/dev/null; then
            exec horizon-wallpaper --set "${img}"
        fi
        exec perihelion-wallpaper "${img}"
    fi
done
