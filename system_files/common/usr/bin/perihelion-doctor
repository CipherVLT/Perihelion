#!/usr/bin/env bash
# Perihelion health check. Run it in a terminal when something is wrong and
# share the output (or the file it saves) when asking for help.
#
#   perihelion-doctor            print the report
#   perihelion-doctor --save     also save it to ~/perihelion-doctor.txt
set -uo pipefail

report() {
    section() { printf '\n=== %s ===\n' "$1"; }
    ok() { printf '  ok    %s\n' "$1"; }
    bad() { printf '  FAIL  %s\n' "$1"; }

    section "System"
    cat /usr/share/perihelion/release 2>/dev/null || bad "/usr/share/perihelion/release missing (not a Perihelion install?)"
    printf 'kernel %s\n' "$(uname -r)"
    printf 'session %s (%s)\n' "${XDG_CURRENT_DESKTOP:-none}" "${XDG_SESSION_TYPE:-none}"

    section "Key packages"
    rpm -q mangowm hyprland niri swaybg fuzzel kitty firefox gamescope git gcc \
        sddm pipewire wireplumber 2>/dev/null | grep -v 'is not installed'
    command -v strata >/dev/null && ok "strata $(strata --version 2>/dev/null | head -n1)"
    [[ -f /usr/share/perihelion/simpbar.ref ]] && ok "Perihelion Shell $(cut -c1-7 /usr/share/perihelion/simpbar.ref) (built from source)"

    if command -v mango >/dev/null; then
        section "Mango config"
        cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/mango/config.conf"
        if [[ -f "${cfg}" ]]; then
            if out=$(mango -p -c "${cfg}" 2>&1); then
                ok "${cfg} parses"
            else
                bad "${cfg} has errors:"
                printf '%s\n' "${out}" | sed 's/\x1b\[[0-9;]*m//g; s/^/        /'
            fi
            # Every program a bind or autostart line launches must exist.
            while read -r prog; do
                [[ -n "${prog}" ]] || continue
                if command -v "${prog}" >/dev/null 2>&1 || [[ -x "${prog}" ]]; then
                    ok "found ${prog}"
                else
                    bad "missing ${prog} (used in ${cfg})"
                fi
            done < <(sed -n -E 's/^(bind[a-z]*|mousebind|axisbind|gesturebind)=[^,]*,[^,]*,spawn,([^ ,]+).*/\2/p; s/^exec_once=([^ ]+).*/\1/p' "${cfg}" "$(dirname "${cfg}")"/cfg/*.conf 2>/dev/null | sort -u)
        else
            bad "no ${cfg} (Mango uses its built-in defaults)"
        fi
    fi

    if command -v perihelion-bar >/dev/null; then
        section "Perihelion Bar and Shell"
        sb="${XDG_CONFIG_HOME:-${HOME}/.config}/simpbar"
        running_n() { pgrep -fc "^(/usr/bin/)?$1( |\$)" 2>/dev/null || true; }
        bars=$(running_n perihelion-bar)
        if (( bars > 2 )); then bad "${bars} perihelion-bar copies running (duplicate bar or dock): Super+Shift+D"
        elif (( bars == 2 )); then ok "perihelion-bar running (bar and dock)"
        elif (( bars == 1 )); then bad "only one perihelion-bar running (bar or dock missing): Super+Shift+D"
        else bad "perihelion-bar not running: Super+Shift+D"; fi
        if (( $(running_n perihelion-shell) > 0 )); then ok "perihelion-shell running"; else bad "perihelion-shell not running"; fi
        if pgrep -x cava >/dev/null; then ok "cava running"; else bad "cava not running"; fi
        if [[ -f "${sb}/cava.conf" ]]; then
            printf '  info  cava input: %s\n' "$(grep -E '^ *method' "${sb}/cava.conf" | head -n 1 | tr -s ' ')"
            cava_err=$(timeout 3 cava -p "${sb}/cava.conf" 2>&1 </dev/null | grep -aiE 'error|without|fail' | head -n 3)
            if [[ -n "${cava_err}" ]]; then bad "the bar's cava: ${cava_err}"; else ok "the bar's cava starts with ${sb}/cava.conf"; fi
        else
            bad "no ${sb}/cava.conf (the bar writes one that needs PipeWire input)"
        fi
        for f in config.json shell.json; do
            if [[ -f "${sb}/${f}" ]]; then
                if python3 -c "import json,sys; json.load(open(sys.argv[1]))" "${sb}/${f}" 2>/dev/null; then ok "${f} is valid JSON"
                elif command -v python3 >/dev/null; then bad "${f} is not valid JSON (the bar falls back to its defaults)"; fi
            fi
        done
        printf '  info  widgets switched off: %s\n' "$(tr '\n' ' ' < "${sb}/widgets-disabled" 2>/dev/null)"
        if command -v perihelion-weather >/dev/null; then
            printf '  info  weather now: %s\n' "$(perihelion-weather 2>&1 | head -n 1)"
        fi
        if command -v perihelion-theme >/dev/null; then
            printf '  info  colors: %s\n' "$(perihelion-theme --dry-run 2>/dev/null |
                sed -n 's/^  "flavor": "\(.*\)",$/Catppuccin \1, matched to the wallpaper (settings: ~\/.config\/simpbar\/theme)/p')"
        fi
        printf '  info  weather location: %s\n' "$(head -n 1 "${sb}/weather-location" 2>/dev/null || echo 'guessed from your internet address (set it in ~/.config/simpbar/weather-location)')"
        logs="${SIMPBAR_LOG_DIR:-${HOME}/.config/simpbar-config/logs}"
        for prog in perihelion-bar perihelion-dock perihelion-shell; do
            for kind in crash error warning; do
                log="${logs}/${prog}/${kind}.log"
                if [[ -s "${log}" ]]; then
                    printf '  --- %s %s.log (last 8) ---\n' "${prog}" "${kind}"
                    tail -n 8 "${log}" | sed 's/^/        /'
                fi
            done
        done
    fi

    section "Running"
    for proc in mango Hyprland niri perihelion-bar swaybg pipewire wireplumber xdg-desktop-portal; do
        if pgrep -x "${proc}" >/dev/null; then ok "${proc}"; fi
    done

    section "Time"
    timedatectl 2>/dev/null | sed 's/^ *//' || bad "timedatectl failed"
    if [[ "$(timedatectl show -p NTP --value 2>/dev/null)" != yes ]]; then
        bad "internet time (NTP) is off: sudo dnf install chrony && sudo systemctl enable --now chronyd"
    elif [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" != yes ]]; then
        printf '  info  clock not synchronized yet (normal for a minute after going online)\n'
    else
        ok "clock synchronized over the internet"
    fi
    case "$(timedatectl show -p Timezone --value 2>/dev/null)" in
        UTC | Etc/UTC) bad "time zone is UTC: sudo timedatectl set-timezone Your/City (list: timedatectl list-timezones)" ;;
    esac
    if [[ -f /var/lib/perihelion/auto-timezone.done ]]; then
        ok "automatic time zone: done"
    else
        printf '  info  automatic time zone not done yet (tries at each boot until online)\n'
    fi

    section "Wine"
    if [[ -x /opt/wine/bin/wine ]]; then
        ok "$(/opt/wine/bin/wine --version 2>/dev/null) ($(cat /opt/wine/PERIHELION_BUILD 2>/dev/null))"
    else
        bad "/opt/wine is missing (Wine ships with the ISO)"
    fi
    command -v winetricks >/dev/null && ok "winetricks $(winetricks --version 2>/dev/null | head -n1)"
    if [[ ! -e /dev/ntsync ]]; then
        bad "no /dev/ntsync (Wine falls back to slower sync): sudo modprobe ntsync"
    elif [[ -r /dev/ntsync && -w /dev/ntsync ]]; then
        ok "NTSYNC: /dev/ntsync is usable"
    else
        bad "/dev/ntsync isn't usable by you ($(stat -c '%A %U:%G' /dev/ntsync)); log out and back in"
    fi

    section "Network"
    nmcli -t -f STATE,CONNECTIVITY general 2>/dev/null || bad "nmcli failed"

    section "Errors this boot (system)"
    journalctl -b -p err --no-pager -q 2>/dev/null | tail -n 25 || true

    section "Warnings this boot (your session)"
    journalctl --user -b -p warning --no-pager -q 2>/dev/null | tail -n 25 || true

    section "Installer log"
    echo "If the install itself failed or something was never set up, the full log is"
    echo "/root/perihelion-post.log   (view with: sudo less /root/perihelion-post.log)"
}

if [[ "${1:-}" == --save ]]; then
    report | tee "${HOME}/perihelion-doctor.txt"
    printf '\nSaved to %s\n' "${HOME}/perihelion-doctor.txt"
else
    report
fi
