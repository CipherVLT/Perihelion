#!/usr/bin/python3
"""Perihelion wallpaper picker (Super+Shift+W): a grid of previews.

Shows the images in ~/Pictures/Wallpapers (and Perihelion's own). Click one,
or select it and press Enter, to apply it; Esc closes. Random picks one of
yours; Bing downloads today's Bing image into the folder and applies it.

Applying goes through `perihelion-wallpaper-picker --apply FILE`, which uses
swaybg on Mango and Event Horizon's wallpaper on Hyprland and Niri.

Light on purpose: it runs only while open, renders on the CPU (no GPU
memory), and caches thumbnails in ~/.cache/perihelion-wallpapers.
"""
import os

os.environ.setdefault("GSK_RENDERER", "cairo")

import hashlib
import json
import random
import subprocess
import sys
import threading
import urllib.request
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.perihelion.Wallpapers"
EXTS = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".tif", ".tiff"}
THUMB_W, THUMB_H = 240, 135


def pictures_dir() -> Path:
    try:
        out = subprocess.run(["xdg-user-dir", "PICTURES"], capture_output=True, text=True, timeout=2).stdout.strip()
        if out and out != str(Path.home()):
            return Path(out)
    except (OSError, subprocess.SubprocessError):
        pass
    return Path.home() / "Pictures"


WALLS = pictures_dir() / "Wallpapers"
EXTRA = [Path("/usr/share/backgrounds/perihelion")]
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "perihelion-wallpapers"

MATUGEN = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "simpbar" / "matugen.json"

# Catppuccin Macchiato until perihelion-theme has written the wallpaper's
# colors (~/.config/simpbar/matugen.json, the bar's own palette).
DEFAULT_COLORS = {
    "bg_color": "#24273a", "text_color": "#cad3f5", "border_color": "#8aadf4",
    "hover_color": "#363a4f", "popup_bg_color": "#1e2030", "popup_hover_color": "#494d64",
    "workspace_inactive_color": "#6e738d",
}


def theme_colors() -> dict:
    colors = dict(DEFAULT_COLORS)
    try:
        data = json.loads(MATUGEN.read_text())
    except (OSError, ValueError):
        return colors
    for k in colors:
        v = data.get(k)
        if isinstance(v, str):
            v = v.strip().lstrip("#")
            if v.lower().startswith("0x"):
                v = v[2:]
            if len(v) == 8:  # AARRGGBB
                v = v[2:]
            if len(v) == 6 and all(ch in "0123456789abcdefABCDEF" for ch in v):
                colors[k] = "#" + v
    return colors


def rgba(h: str, a: float) -> str:
    return f"rgba({int(h[1:3], 16)}, {int(h[3:5], 16)}, {int(h[5:7], 16)}, {a})"


def build_css() -> str:
    """The picker in the wallpaper's colors, like the bar and app drawer."""
    c = theme_colors()
    return f"""
window {{ background-color: {rgba(c['bg_color'], 0.94)}; color: {c['text_color']}; }}
entry {{ background-color: {c['popup_bg_color']}; color: {c['text_color']}; border: 1px solid {c['border_color']}; border-radius: 10px; padding: 6px 10px; }}
flowboxchild {{ padding: 4px; border-radius: 10px; }}
flowboxchild:selected, flowboxchild:hover {{ background-color: {c['hover_color']}; }}
flowboxchild:selected {{ box-shadow: inset 0 0 0 2px {c['border_color']}; }}
.thumb {{ border-radius: 8px; }}
.name {{ color: {c['text_color']}; font-size: 0.85em; }}
.current .name {{ color: {c['border_color']}; font-weight: bold; }}
button {{ background-color: {c['hover_color']}; color: {c['text_color']}; border-radius: 8px; padding: 4px 14px; border: none; }}
button:hover {{ background-color: {c['popup_hover_color']}; }}
.status {{ color: {c['workspace_inactive_color']}; font-size: 0.85em; }}
"""


def list_images() -> list[Path]:
    WALLS.mkdir(parents=True, exist_ok=True)
    seen, out = set(), []
    for d in [WALLS, *EXTRA]:
        if not d.is_dir():
            continue
        for p in sorted(d.rglob("*"), key=lambda x: x.name.lower()):
            if p.is_file() and p.suffix.lower() in EXTS and p.resolve() not in seen:
                seen.add(p.resolve())
                out.append(p)
    return out


def current_wallpaper() -> str:
    state = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "perihelion" / "wallpaper"
    try:
        kind, _, value = state.read_text().strip().partition(" ")
        return value if kind == "image" else ""
    except OSError:
        return ""


def thumbnail(path: Path) -> Path | None:
    """A cached THUMB_W x THUMB_H preview (cropped to fill), or None."""
    st = path.stat()
    key = hashlib.sha1(f"{path}:{st.st_mtime_ns}:{st.st_size}".encode()).hexdigest()
    out = CACHE / f"{key}.png"
    if out.exists():
        return out
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), THUMB_W * 2, THUMB_H * 2, True)
        scale = max(THUMB_W / pb.get_width(), THUMB_H / pb.get_height())
        w, h = max(THUMB_W, round(pb.get_width() * scale)), max(THUMB_H, round(pb.get_height() * scale))
        pb = pb.scale_simple(w, h, GdkPixbuf.InterpType.BILINEAR)
        pb = pb.new_subpixbuf((w - THUMB_W) // 2, (h - THUMB_H) // 2, THUMB_W, THUMB_H)
        CACHE.mkdir(parents=True, exist_ok=True)
        pb.savev(str(out), "png", [], [])
        return out
    except GLib.Error:
        return None


def apply(path: Path) -> None:
    subprocess.Popen(["perihelion-wallpaper-picker", "--apply", str(path)], start_new_session=True)


class Picker(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application):
        super().__init__(application=app, title="Wallpapers")
        self.set_default_size(1100, 640)
        self.current = current_wallpaper()

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=14, margin_bottom=10, margin_start=14, margin_end=14)
        self.set_child(box)

        self.search = Gtk.SearchEntry(placeholder_text="Search wallpapers", hexpand=True)
        self.search.connect("search-changed", lambda *_: self.flow.invalidate_filter())
        self.search.connect("activate", lambda *_: self.apply_selected())
        box.append(self.search)

        self.flow = Gtk.FlowBox(valign=Gtk.Align.START, max_children_per_line=12, min_children_per_line=2,
                                selection_mode=Gtk.SelectionMode.SINGLE, homogeneous=True,
                                column_spacing=6, row_spacing=6, activate_on_single_click=True)
        self.flow.set_filter_func(self.filter)
        self.flow.connect("child-activated", lambda _f, child: self.apply_path(child.path))
        scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroll.set_child(self.flow)
        box.append(scroll)

        bar = Gtk.Box(spacing=8)
        self.status = Gtk.Label(xalign=0, hexpand=True, css_classes=["status"])
        bar.append(self.status)
        for label, handler in (("Open folder", self.open_folder), ("Bing", self.bing), ("Random", self.random)):
            b = Gtk.Button(label=label)
            b.connect("clicked", handler)
            bar.append(b)
        box.append(bar)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.images: list[Path] = []
        self.reload()

    # -- grid -------------------------------------------------------------------
    def reload(self):
        child = self.flow.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.flow.remove(child)
            child = nxt
        self.images = list_images()
        self.status.set_text(f"{len(self.images)} wallpapers in {WALLS} · Enter apply · Esc close")
        for p in self.images:
            self.flow.append(self.tile(p))
        threading.Thread(target=self.fill_thumbs, daemon=True).start()

    def tile(self, path: Path) -> Gtk.FlowBoxChild:
        child = Gtk.FlowBoxChild()
        child.path = path
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        pic = Gtk.Picture(width_request=THUMB_W, height_request=THUMB_H, can_shrink=True,
                          content_fit=Gtk.ContentFit.COVER, css_classes=["thumb"])
        child.picture = pic
        name = path.name if len(path.name) <= 32 else path.name[:15] + "…" + path.name[-14:]
        v.append(pic)
        v.append(Gtk.Label(label=name, css_classes=["name"], ellipsize=3))
        child.set_child(v)
        if str(path) == self.current:
            child.add_css_class("current")
        return child

    def fill_thumbs(self):
        child = self.flow.get_first_child()
        children = []
        while child:
            children.append(child)
            child = child.get_next_sibling()
        for c in children:
            t = thumbnail(c.path)
            if t:
                GLib.idle_add(c.picture.set_filename, str(t))

    def filter(self, child) -> bool:
        q = self.search.get_text().strip().lower()
        return not q or q in child.path.name.lower()

    # -- actions ----------------------------------------------------------------
    def apply_path(self, path: Path):
        apply(path)
        self.close()

    def apply_selected(self):
        sel = self.flow.get_selected_children()
        if sel:
            self.apply_path(sel[0].path)
            return
        # Enter in the search box: the first visible match.
        child = self.flow.get_first_child()
        while child:
            if child.get_child_visible() and self.filter(child):
                self.apply_path(child.path)
                return
            child = child.get_next_sibling()

    def random(self, *_):
        mine = [p for p in self.images if WALLS in p.parents] or self.images
        if mine:
            self.apply_path(random.choice(mine))

    def open_folder(self, *_):
        subprocess.Popen(["xdg-open", str(WALLS)], start_new_session=True)

    def bing(self, button):
        button.set_sensitive(False)
        button.set_label("Downloading…")

        def work():
            try:
                with urllib.request.urlopen("https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=en-US", timeout=15) as r:
                    img = json.load(r)["images"][0]
                url = "https://www.bing.com" + img["urlbase"] + "_UHD.jpg"
                dest = WALLS / f"bing-{img.get('startdate', 'today')}.jpg"
                if not dest.exists():
                    with urllib.request.urlopen(url, timeout=60) as r, open(dest, "wb") as f:
                        f.write(r.read())
                GLib.idle_add(self.apply_path, dest)
            except (OSError, ValueError, KeyError, IndexError) as e:
                GLib.idle_add(self.status.set_text, f"Bing download failed: {e}")
                GLib.idle_add(button.set_label, "Bing")
                GLib.idle_add(button.set_sensitive, True)

        threading.Thread(target=work, daemon=True).start()

    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False


def main() -> int:
    app = Gtk.Application(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    css = Gtk.CssProvider()

    def load_css(*_):
        text = build_css()
        css.load_from_string(text) if hasattr(css, "load_from_string") else css.load_from_data(text.encode())

    # Recolors live when a new wallpaper's colors are written.
    monitor = Gio.File.new_for_path(str(MATUGEN)).monitor_file(Gio.FileMonitorFlags.NONE, None)
    monitor.connect("changed", lambda _m, _f, _o, ev: ev in (
        Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED, Gio.FileMonitorEvent.RENAMED,
        Gio.FileMonitorEvent.MOVED_IN) and load_css())

    def on_activate(a):
        load_css()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = a.get_active_window() or Picker(a)
        win.present()

    app.connect("activate", on_activate)
    return app.run(sys.argv[:1])


if __name__ == "__main__":
    sys.exit(main())
