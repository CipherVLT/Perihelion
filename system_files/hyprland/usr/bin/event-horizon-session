#!/usr/bin/env bash
# Perihelion Hyprland session (picked on the login screen as "Event Horizon").
# Seeds a Hyprland config on first login, writes the GPU environment, then
# starts Hyprland. Event Horizon itself is started from hyprland.lua.
#
# Ported from horizon-forge (CipherVLT/horizon-forge, Apache-2.0); the
# Bazzite/ostree-only steps were dropped.
set -euo pipefail

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export XDG_SESSION_TYPE=wayland
# GTK 3 and Electron apps use the system Open/Save dialog (Strata, through
# xdg-desktop-portal) instead of their built-in one.
export GTK_USE_PORTAL=1

cd "${HOME}" || true

config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/perihelion"
skel=/usr/share/event-horizon/skel

mkdir -p "${config_home}/hypr/eh" "${config_home}/Event-Horizon" "${state_dir}"

# Hyprland 0.57+ reads only Lua; 0.56 already prefers hyprland.lua. Seed it
# once. An unedited copy of an older default is replaced so updates reach
# it; a config you changed is never touched.
hypr_lua="${config_home}/hypr/hyprland.lua"
if [[ ! -e "${hypr_lua}" ]]; then
    cp "${skel}/hypr/hyprland.lua" "${hypr_lua}"
else
    current=$(sha256sum "${hypr_lua}" | cut -d' ' -f1)
    if grep -qx "${current}" "${skel}/hypr/previous-defaults.sha256" 2>/dev/null; then
        cp "${skel}/hypr/hyprland.lua" "${hypr_lua}"
    fi
fi

# First login: point Event Horizon at the Perihelion wallpaper. After that
# the shell's own Wallpaper settings own this file.
eh_settings="${config_home}/Event-Horizon/settings.toml"
wallpaper=/usr/share/backgrounds/perihelion/default.png
if [[ ! -e "${eh_settings}" && -f "${wallpaper}" ]]; then
    printf '[wallpaper]\nenabled = true\nmode = 0\nimage = "%s"\n' "${wallpaper}" > "${eh_settings}"
fi

# GPU environment, regenerated at every login from the hardware present, so
# one ISO works on an AMD desktop and an Intel+NVIDIA laptop. Do not edit
# gpu.lua; put overrides further down in hyprland.lua.
gpu_lua="${config_home}/hypr/eh/gpu.lua"
{
    echo "-- Generated by event-horizon-session at login. Do not edit."
    nvidia=""
    other=""
    for card in /sys/class/drm/card[0-9]*; do
        [[ -e "${card}/device/vendor" ]] || continue
        vendor=$(<"${card}/device/vendor")
        node="/dev/dri/$(basename "${card}")"
        case "${vendor}" in
            0x10de) nvidia="${nvidia:+${nvidia}:}${node}" ;;
            *)      other="${other:+${other}:}${node}" ;;
        esac
    done
    if [[ -n "${nvidia}" && -z "${other}" ]]; then
        # NVIDIA only. https://wiki.hypr.land/Nvidia/
        echo 'hl.env("LIBVA_DRIVER_NAME", "nvidia")'
        echo 'hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")'
        echo 'hl.env("NVD_BACKEND", "direct")'
        echo 'hl.config({ cursor = { no_hardware_cursors = true } })'
    elif [[ -n "${nvidia}" ]]; then
        # Hybrid laptop: the desktop stays on the integrated GPU so the
        # NVIDIA card can sleep; its outputs still work as a secondary GPU.
        echo "hl.env(\"AQ_DRM_DEVICES\", \"${other}:${nvidia}\")"
        echo 'hl.config({ cursor = { no_hardware_cursors = true } })'
    fi
} > "${gpu_lua}"

# Event Horizon caches an icon index keyed on folder modification times.
# Drop it whenever the set of installed icon files changes.
icon_index="${XDG_CACHE_HOME:-${HOME}/.cache}/Event-Horizon/icon-index"
icon_state="${state_dir}/icon-files"
icon_fp=$(ls -R /usr/share/icons /usr/share/pixmaps /usr/local/share/icons \
    /var/lib/flatpak/exports/share/icons "${HOME}/.local/share/icons" 2>/dev/null | md5sum) || true
if [[ "$(cat "${icon_state}" 2>/dev/null)" != "${icon_fp}" ]]; then
    rm -rf "${icon_index}"
    printf '%s\n' "${icon_fp}" > "${icon_state}"
fi

# Strata draws its own colors; match them to the GTK theme.
/usr/libexec/perihelion-strata-theme >/dev/null 2>&1 &

# start-hyprland is Hyprland's own launcher (crash recovery, safe mode).
if command -v start-hyprland >/dev/null 2>&1; then
    exec start-hyprland
fi
exec /usr/bin/Hyprland
