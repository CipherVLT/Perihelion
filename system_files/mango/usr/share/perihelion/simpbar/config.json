{
  "appearance": {
    "bg_color": "#24273A",
    "text_color": "#CAD3F5",
    "border_color": "#8AADF4",
    "hover_color": "#363A4F",
    "workspace_active_color": "#8AADF4",
    "workspace_inactive_color": "#6E738D",
    "popup_bg_color": "#1E2030",
    "popup_hover_color": "#363A4F",
    "popup_separator_color": "#494D64",
    "popup_disabled_color": "#6E738D",
    "module_bg_color": "#363A4F",
    "bezel_color": "#8AADF4",
    "bezel_style": "solid",
    "bezel_effect": "solid",
    "bg_mode": "none",
    "position": "top",
    "bar_mode": "taskbar",
    "bar_height": 28,
    "border_top_px": 0,
    "border_bottom_px": 2,
    "border_left_px": 0,
    "border_right_px": 0,
    "corner_radius_px": 0,
    "bg_opacity_percent": 90,
    "module_pills": true,
    "pill_borders": false,
    "clock_format": "date_12h",
    "font_path": "@FONT_PATH@",
    "animations_enabled": true
  },
  "modules": {
    "left": [
      { "kind": "workspaces" },
      { "kind": "layout" },
      { "kind": "mpris" }
    ],
    "center": [
      { "kind": "launchers" },
      { "kind": "clock" }
    ],
    "right": [
      { "kind": "tray" },
      { "kind": "network" },
      { "kind": "volume" },
      { "kind": "battery" }
    ]
  },
  "launchers": [
    { "label": "Browser", "command": "firefox" },
    { "label": "Files", "command": "strata" },
    { "label": "Term", "command": "kitty" },
    { "label": "Steam", "command": "steam" }
  ]
}
