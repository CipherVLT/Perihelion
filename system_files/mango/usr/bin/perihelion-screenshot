#!/usr/bin/env bash
# Screenshot to ~/Pictures/Screenshots and the clipboard (grim + slurp).
#
#   perihelion-screenshot region   drag a box (Super+Shift+S, Super+Print)
#   perihelion-screenshot full     every screen (Print, Alt+Print)
set -euo pipefail

mode=${1:-region}
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "${HOME}/Pictures")/Screenshots"
mkdir -p "${dir}"
file="${dir}/Screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"

case "${mode}" in
    region)
        # Esc in slurp cancels: nothing is saved.
        geometry=$(slurp -d -b 24273a88 -c 8aadf4ff -w 2) || exit 0
        grim -g "${geometry}" "${file}"
        ;;
    full)
        grim "${file}"
        ;;
    *)
        echo "usage: $0 region|full" >&2
        exit 1
        ;;
esac

wl-copy --type image/png < "${file}"
echo "${file}"
