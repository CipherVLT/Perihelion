#!/usr/bin/env bash
# Show every keybind from your Mango config in a searchable list (Super+H).
# Reads the "#: description" line above each bind in
# ~/.config/mango/config.conf. Run with --print to list them in a terminal.
set -euo pipefail

config="${XDG_CONFIG_HOME:-${HOME}/.config}/mango/config.conf"
[[ -f "${config}" ]] || config=/usr/share/perihelion/mango/config.conf

list=$(awk '
    /^#: / { desc = substr($0, 4); next }
    /^key_mode=/ { mode = substr($0, 10); next }
    /^(bind[a-z]*|mousebind|axisbind|gesturebind)=/ {
        line = $0
        sub(/^[a-z]+=/, "", line)
        n = split(line, f, ",")
        if ($0 ~ /^gesturebind=/) {
            keys = f[3] "-finger swipe " f[2]
        } else {
            mods = (f[1] == "NONE" || f[1] == "none") ? "" : f[1] "+"
            keys = mods f[2]
        }
        if (mode != "" && mode != "default") keys = "[" mode "] " keys
        if (desc == "") {
            first = ($0 ~ /^gesturebind=/) ? 4 : 3
            desc = f[first]; for (i = first + 1; i <= n; i++) desc = desc " " f[i]
        }
        printf "%-30s %s\n", keys, desc
        desc = ""
    }
' "${config}")

if [[ "${1:-}" == --print ]] || ! command -v fuzzel >/dev/null; then
    printf '%s\n' "${list}"
    exit 0
fi
printf '%s\n' "${list}" | fuzzel --dmenu --prompt 'keys > ' --width 70 --lines 20 >/dev/null || true
