#!/usr/bin/env bash
# Starts Perihelion Bar and its dock (Super+Shift+D runs it again to restart
# both). The bar waits until PipeWire/WirePlumber have a default audio
# output, so its cava connects to it (started earlier, that cava can stay
# unconnected and the visualizer flat); at most 10 seconds.
#
# The dock is a second Perihelion Bar in dock mode (SIMPBAR_DOCK=1): the
# pinned apps from ~/.config/simpbar/config.json, bottom center, with the
# app drawer (the distro logo) first and the trash last. It is off until
# switched on in Perihelion Settings (Modules > Dock); when off it exits
# right away. It starts after the wait, with the bar, once the session is
# fully up (started at the first instant of a session it could miss it).
#
# Exactly one bar and one dock: every running copy (including duplicates
# from older builds) is stopped first, and each new copy holds a lock, so a
# second one of either kind just exits.
if pkill -x perihelion-bar 2>/dev/null; then
    for _ in $(seq 1 20); do
        pgrep -x perihelion-bar >/dev/null || break
        sleep 0.1
    done
    pkill -9 -x perihelion-bar 2>/dev/null
fi
for _ in $(seq 1 20); do
    wpctl inspect @DEFAULT_AUDIO_SINK@ >/dev/null 2>&1 && break
    sleep 0.5
done
SIMPBAR_DOCK=1 setsid -f perihelion-bar >/dev/null 2>&1
# Explicitly not the dock, even if this script inherited SIMPBAR_DOCK=1.
exec env -u SIMPBAR_DOCK perihelion-bar "$@"
